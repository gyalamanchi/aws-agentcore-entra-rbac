# Copy to entra/.env (GITIGNORED — holds a client secret, NEVER commit) and fill in from the
# Microsoft Entra admin center. See README section 8 / plan Part 0 for where each value comes from.

# ---- Tenant ----
TENANT_ID=4b7f45a9-xxxx-xxxx-xxxx-xxxxxxxxxxxx        # Entra > Overview > Directory (tenant) ID

# ---- App A: front-end SPA (public client, PKCE) ----
SPA_CLIENT_ID=c1a0c3f8-xxxx-xxxx-xxxx-xxxxxxxxxxxx    # App A > Application (client) ID
SPA_REDIRECT_URI=https://localhost:5173                # App A > Authentication > SPA redirect URI (https: corp tenants require it; serve via frontend/serve_https.sh)

# ---- App B: AgentCore API (the audience the tokens are FOR) ----
API_CLIENT_ID=c1a0c3f8-xxxx-xxxx-xxxx-xxxxxxxxxxxx    # App B > Application (client) ID
API_APP_ID_URI=api://c1a0c3f8-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # App B > Expose an API > Application ID URI
API_CLIENT_SECRET=~replace-me~                          # App B > Certificates & secrets (for the OBO/exchange shim)

# ---- Scopes & roles you defined on App B ----
# Delegated scope the front-end requests (Expose an API > Scopes). Full value the SPA asks for:
API_SCOPE=api://c1a0c3f8-xxxx-xxxx-xxxx-xxxxxxxxxxxx/mcp.invoke
# App roles you defined (App B > App roles) and ASSIGNED to your user (Enterprise apps > Users and groups):
ROLE_READER=Tools.Reader
ROLE_ADMIN=Tools.Admin

# ---- Derived (leave as-is; scripts compute the v2 discovery URL from TENANT_ID) ----
# DISCOVERY_URL=https://login.microsoftonline.com/${TENANT_ID}/v2.0/.well-known/openid-configuration
