# NEVER commit credentials or secrets
.env
.env.*
!**/.env.example
*.pem
credentials
**/credentials
.aws/

# captured tokens — never commit real JWTs
*.token
token-dump*.json

# front-end
frontend/node_modules/
frontend/dist/

# the CLI installer (already installed)
AWSCLIV2.pkg

# python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# AgentCore starter-toolkit deploy artifacts (contain account id / role arn, not secrets,
# but not worth committing). The Dockerfile/.dockerignore are generated by `agentcore configure`.
.bedrock_agentcore.yaml
Dockerfile
.dockerignore

# terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform.tfvars

# gateway / eval artifacts (gateway_info.json holds a Cognito client secret)
gateway/gateway_info.json
evals/results*.json
**/.bedrock_agentcore.yaml
mcp_server/Dockerfile
mcp_server/.dockerignore
gateway/Dockerfile
gateway/.dockerignore

# os
.DS_Store

# local https cert for the front-end (self-signed, do not commit)
frontend/cert.pem
frontend/key.pem

frontend/config.js
